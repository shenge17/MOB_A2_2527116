{
  "expo": {
    "name": "USAPortfolio",
    "slug": "usaportfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F9FF"
    },
    "android": {
      "package": "rw.ac.ines.ug2527116.usaportfolio",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#38BDF8"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "USAPortfolio uses your photos only to set your profile picture on this device.",
          "cameraPermission": "USAPortfolio uses the camera only to take your profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}